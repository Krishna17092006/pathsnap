    "speed_mps",
    "log_dt_prev",
    "log_dt_next",
    "log_arc_length",
    "t_along",
    "is_two_way",
    "out_degree_v",
    "in_degree_u",
    "prev_nearest_link",
    "next_nearest_link"
  ],
  "configs": {
    "gnb_all": {
      "description": "GaussianNB on all 19 raw features",
      "params": {
        "var_smoothing": 1e-09
      }
    },
    "gnb_quantile": {
      "description": "QuantileTransformer(normal) -> GaussianNB",
      "params": {
        "var_smoothing": 1e-09
      }
    },
    "gnb_decorrelated": {
      "description": "QuantileTransformer(normal) -> drop |r| > 0.8 -> GaussianNB",
      "params": {
        "var_smoothing": 1e-09,
        "corr_threshold": 0.8
      }
    }
  },
  "kept_features_final_fit": {
