      "dist_m",
      "dist_minus_min",
      "n_cand",
      "has_heading",
      "cos_heading_weighted",
      "speed_mps",
      "log_dt_prev",
      "log_dt_next",
      "log_arc_length",
      "t_along",
      "is_two_way",
      "out_degree_v",
      "in_degree_u",
      "prev_nearest_link",
      "next_nearest_link"
    ]
  },
  "selection_rule": "highest mean CV Top-1 (student_test never used for selection)",
  "selected_config": "gnb_decorrelated"
}